{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "builderlab/quote",
	"title": "BuilderLab Quote",
	"category": "builderlab",
	"icon": "format-quote",
	"description": "A quotation with an optional visible source.",
	"attributes": {
		"content": {
			"type": "string",
			"default": ""
		},
		"source": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "builderlab-editor",
	"style": "builderlab-frontend",
	"render": "file:./render.php"
}
